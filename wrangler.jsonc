// Configuració de Cloudflare Workers per a «Casal · Gestió integral».
// Un sol Worker serveix el frontend (Static Assets) i l'API (/api/*).
// Cap secret en aquest fitxer: els secrets es configuren amb `wrangler secret put`
// o des del tauler de Cloudflare. Els database_id no són secrets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "casal-gestio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Entorn local (per defecte). D1 local amb Miniflare; l'id és un marcador.
  "vars": {
    "APP_ENV": "local",
    "ALLOWED_ORIGINS": "http://localhost:5173"
  },
  // Limitació d'enviaments del formulari públic: 10 per minut per origen de xarxa.
  // Els límits no s'hereten entre entorns: cal repetir-los a cada entorn.
  "ratelimits": [
    { "name": "LIMIT_SOLLICITUDS", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  // Fitxers de PG-Cartells (plantilles, fotografies, materials). Bucket privat: només s'hi accedeix des del Worker.
  "r2_buckets": [
    { "binding": "FITXERS", "bucket_name": "casal-gestio-fitxers-local" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "casal-gestio-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "db/migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "casal-gestio-staging",
      "vars": {
        "APP_ENV": "staging",
        "ALLOWED_ORIGINS": ""
      },
      "ratelimits": [
        { "name": "LIMIT_SOLLICITUDS", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
      ],
      "r2_buckets": [
        { "binding": "FITXERS", "bucket_name": "casal-gestio-fitxers-staging" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "casal-gestio-staging",
          "database_id": "SUBSTITUIR-PER-ID-D1-STAGING",
          "migrations_dir": "db/migrations"
        }
      ]
    },
    "production": {
      "name": "casal-gestio",
      "vars": {
        "APP_ENV": "production",
        "ALLOWED_ORIGINS": ""
      },
      "ratelimits": [
        { "name": "LIMIT_SOLLICITUDS", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
      ],
      "r2_buckets": [
        { "binding": "FITXERS", "bucket_name": "casal-gestio-fitxers-production" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "casal-gestio-production",
          "database_id": "SUBSTITUIR-PER-ID-D1-PRODUCCIO",
          "migrations_dir": "db/migrations"
        }
      ]
    }
  }
}
